<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material You (API 31+): same role mapping as Theme.kt's dynamic dark scheme
         (surface = neutral1_900, onSurface = neutral1_100, primary = accent1_200,
         onSurfaceVariant = neutral2_200), so launch and splash match the app's first frame. -->
    <color name="ruta_theme_surface">@android:color/system_neutral1_900</color>
    <color name="ruta_theme_on_surface">@android:color/system_neutral1_100</color>
    <color name="ruta_theme_primary">@android:color/system_accent1_200</color>
    <color name="ruta_theme_on_surface_variant">@android:color/system_neutral2_200</color>
</resources>
