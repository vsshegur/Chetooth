<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Ruta brand mark (launcher icon, splash, in-app BrandMark): fixed, not dynamic.
         Lime 9-point cookie badge with a dark electric_moped glyph, on the dark green-black plate. -->
    <color name="ruta_lime">#FFB7F36B</color>
    <color name="ruta_ink">#FF0E1A12</color>
    <color name="ic_launcher_background">#FF0E1A12</color>

    <!-- Window/theme roles (dark scheme). The UI paints its own Material You colours in code (Theme.kt);
         these only cover what the framework draws before the first frame: window background, splash
         screen, framework widgets/dialogs. API 30 fallback = tones of seed #8BD450 (hue 128):
         surface T10, onSurface T90, primary T80, onSurfaceVariant T80 (neutral variant).
         values-v31/colors.xml maps the same names to the system tonal palettes (dynamic colour). -->
    <color name="ruta_theme_surface">#FF1A1C18</color>
    <color name="ruta_theme_on_surface">#FFE1E3DE</color>
    <color name="ruta_theme_primary">#FFADD28A</color>
    <color name="ruta_theme_on_surface_variant">#FFC2C8BC</color>
</resources>
